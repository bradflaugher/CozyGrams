<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      A dark theme so the window that appears before the first frame is drawn is the
      same deep plum as the game itself. A light theme flashes white, which is genuinely
      unpleasant on a large panel in a dim living room.
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#FF7A9E</item>
        <item name="android:colorBackground">#1B1430</item>
        <item name="android:windowBackground">@drawable/launch_backdrop</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!--
          Draw under a landscape phone's camera cutout too; the game keeps its own
          controls out of it through the window insets.
        -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <!-- Android 12+ draws its own splash screen and ignores windowBackground for it. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#1B1430</item>
    </style>
</resources>
