<?xml version="1.0" encoding="utf-8"?>
<!--
  Phones mask launcher icons into their own shape, so the painted heart becomes an
  adaptive icon: the plum ground as the background layer and the painting, inset so the
  heart sits inside the 66dp safe zone, as the foreground. Televisions still use the
  banner; the square PNGs in mipmap-* remain for anything that asks for a bitmap.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/app_icon"
            android:inset="9dp" />
    </foreground>
</adaptive-icon>
